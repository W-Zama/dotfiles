# ホワイトリスト形式: 全てを無視し、特定のファイルのみ追跡

# 全てを無視
/*
/.*

# 追跡するファイル
!/.gitignore
!/.gitconfig
!/.vimrc
!/.zshrc
!/README.md

# 追跡するディレクトリ
!/.bin/
/.bin/*
!/.bin/install.sh
!/.config/
/.config/*
!/.config/karabiner/
/.config/karabiner/*
!/.config/karabiner/karabiner.json
!/.claude/
/.claude/*
!/.claude/settings.json
