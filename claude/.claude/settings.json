          {
            "type": "command",
            "command": "echo 'export PATH=/Users/wataru.zama/.anyenv/envs/goenv/shims:/Users/wataru.zama/.anyenv/envs/goenv/versions/1.25.8/bin:/opt/homebrew/bin:/Users/wataru.zama/go/bin:/Users/wataru.zama/development/flutter/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin' >> \"$CLAUDE_ENV_FILE\" && echo 'export GOROOT=/Users/wataru.zama/.anyenv/envs/goenv/versions/1.25.8' >> \"$CLAUDE_ENV_FILE\" && echo 'export GOPATH=/Users/wataru.zama/go' >> \"$CLAUDE_ENV_FILE\" && echo 'export GO111MODULE=on' >> \"$CLAUDE_ENV_FILE\""
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Claude Codeが許可を求めています\" with title \"Claude Code\" subtitle \"確認待ち\" sound name \"Funk\"'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"タスクが完了しました\" with title \"Claude Code\" subtitle \"処理終了\" sound name \"Blow\"'"
          }
        ]
      }
    ]
  },
